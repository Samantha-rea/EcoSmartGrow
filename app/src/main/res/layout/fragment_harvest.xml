<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Harvest Analytics"
        android:textSize="24sp"
        android:textColor="?attr/colorPrimary"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"
        android:textAllCaps="true"
        android:letterSpacing="0.1" />

    <!-- Harvest Countdown -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        style="@style/Widget.EcoSmartGrow.CardView.Neon"
        app:strokeColor="@color/neon_green_alpha">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Harvest Countdown"
                android:textSize="18sp"
                android:textColor="@color/neon_green"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_days_remaining"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="9 days until harvest"
                android:textSize="32sp"
                android:textColor="@color/text_light"
                android:textStyle="bold"
                android:layout_marginTop="12dp" />

            <ProgressBar
                android:id="@+id/harvest_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:layout_marginTop="16dp"
                android:progress="65"
                android:progressTint="@color/neon_green"
                android:progressBackgroundTint="@color/dark_surface_variant" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_current_stage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Vegetative"
                    android:textSize="16sp"
                    android:textColor="@color/neon_green"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_stage_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Day 12 of 21"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Growth Metrics -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="24dp"
        android:weightSum="3">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            style="@style/Widget.EcoSmartGrow.CardView.Neon"
            app:strokeColor="@color/neon_blue_alpha">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tv_plant_height"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="18 cm"
                    android:textSize="20sp"
                    android:textColor="@color/neon_blue"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Height"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:textAllCaps="true" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            style="@style/Widget.EcoSmartGrow.CardView.Neon"
            app:strokeColor="@color/neon_pink_alpha">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tv_health_score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="94%"
                    android:textSize="20sp"
                    android:textColor="@color/neon_pink"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Health"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:textAllCaps="true" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            style="@style/Widget.EcoSmartGrow.CardView.Neon"
            app:strokeColor="@color/neon_purple_alpha">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tv_growth_rate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+2.3"
                    android:textSize="20sp"
                    android:textColor="@color/neon_purple"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="cm/week"
                    android:textSize="10sp"
                    android:textColor="@color/text_secondary"
                    android:textAllCaps="true" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- Growth Log -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Growth Log History"
        android:textSize="18sp"
        android:textColor="?attr/colorPrimary"
        android:textStyle="bold"
        android:layout_marginBottom="12dp"
        android:textAllCaps="true"
        android:letterSpacing="0.05" />

    <ListView
        android:id="@+id/lv_growth_logs"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@null"
        android:dividerHeight="8dp" />

</LinearLayout>