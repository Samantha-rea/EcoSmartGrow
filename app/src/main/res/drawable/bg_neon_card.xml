<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Glow effect (outermost) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#0D39FF14" /> <!-- Very transparent neon green -->
        </shape>
    </item>

    <!-- Border -->
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <stroke android:width="1.5dp" android:color="@color/neon_green" />
            <solid android:color="@color/dark_surface" />
        </shape>
    </item>
</layer-list>